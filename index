      '<label class="al">Titel:</label><input class="ai" id="miniHistTitle_' + id + '" value="' + escHtml(ch.title) + '">' +
      '<label class="al">Gegner:</label><input class="ai" id="miniHistOpponent_' + id + '" value="' + escHtml(ch.opponent) + '">' +
